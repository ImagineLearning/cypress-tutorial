{
	"name": "cypress-tutorial",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"start": "craco start",
		"build": "craco build",
		"test": "craco test"
	},
	"dependencies": {
		"@craco/craco": "^5.9.0",
		"@testing-library/jest-dom": "^5.11.4",
		"@testing-library/react": "^11.1.0",
		"@testing-library/user-event": "^12.1.10",
		"@types/jest": "^26.0.15",
		"@types/node": "^12.0.0",
		"@types/react": "^16.9.53",
		"@types/react-dom": "^16.9.8",
		"react": "^17.0.1",
		"react-dom": "^17.0.1",
		"react-scripts": "4.0.1",
		"react-table": "^7.6.2",
		"typescript": "^4.0.3",
		"web-vitals": "^0.2.4"
	},
	"devDependencies": {
		"@types/react-table": "^7.0.25",
		"@typescript-eslint/eslint-plugin": "^4.9.0",
		"@typescript-eslint/parser": "^4.9.0",
		"autoprefixer": "^9.8.6",
		"eslint": "^7.14.0",
		"eslint-loader": "^4.0.2",
		"postcss": "^7.0.35",
		"tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.0.1"
	},
	"eslintConfig": {
		"extends": [
			"eslint:recommended",
			"plugin:@typescript-eslint/recommended",
			"react-app",
			"react-app/jest"
		],
		"parser": "@typescript-eslint/parser",
		"plugins": [
			"@typescript-eslint"
		],
		"rules": {
			"no-restricted-imports": [
				"error",
				"rxjs/Rx"
			],
			"@typescript-eslint/explicit-module-boundary-types": "off"
		}
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"overrides": {
		"loader-utils@^1.0.0": "1.4.2",
		"loader-utils@^2.0.0": "2.0.4",
		"form-data": "2.5.6",
		"shell-quote": "1.12.0",
		"minimatch": "3.1.4",
		"qs": "6.17.1",
		"ansi-html": "0.0.8",
		"browserify-sign": "4.2.2",
		"path-to-regexp": "0.1.13",
		"body-parser": "1.20.9",
		"cross-spawn@^7.0.0": "7.0.5",
		"serve-static": "1.16.3"
	}
}
